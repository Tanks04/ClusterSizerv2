/* Cross-platform baseline: do not rely on the native OS palette. */
QWidget
{
    color: #212121;
    background-color: #f5f5f5;
}

/* Anything the person types or picks a value into stays white,
   distinct from the app's gray background - makes editable fields
   immediately obvious at a glance. */
QLineEdit, QPlainTextEdit, QTextEdit,
QSpinBox, QDoubleSpinBox, QComboBox,
QDateEdit, QDateTimeEdit
{
    background-color: #ffffff;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled,
QDateEdit:disabled, QDateTimeEdit:disabled
{
    background-color: #f0f0f0;
    color: #9e9e9e;
}

QToolTip
{
    color: #212121;
    background-color: #ffffff;
    border: 1px solid #bdbdbd;
}

/* Once QWidget's own background/color is styled above, Qt silently
   stops drawing the native checked dot/checkmark on radio buttons and
   checkboxes unless the indicator is explicitly styled here - this is
   what caused "I can click the options but no dot shows which one is
   selected." */
QRadioButton::indicator, QCheckBox::indicator
{
    width: 13px;
    height: 13px;
    border: 1px solid #757575;
    background-color: #ffffff;
}

QRadioButton::indicator
{
    border-radius: 7px;
}

QCheckBox::indicator
{
    border-radius: 2px;
}

QRadioButton::indicator:checked
{
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #1976d2, stop: 0.5 #1976d2, stop: 0.6 #ffffff, stop: 1 #ffffff
    );
}

QCheckBox::indicator:checked
{
    background-color: #1976d2;
    border: 1px solid #1976d2;
}

QRadioButton::indicator:disabled, QCheckBox::indicator:disabled
{
    background-color: #f0f0f0;
    border: 1px solid #bdbdbd;
}

QFrame#SummaryWidget
{
    border: 1px solid #bdbdbd;
    border-radius: 8px;
    background-color: white;
}

QFrame#SummaryWidget:hover
{
    border: 2px solid #1976d2;
}

QFrame#SiteCapacityWidget
{
    border: 1px solid #bdbdbd;
    border-radius: 8px;
    background-color: white;
    padding: 8px;
}
