/* Cross-platform baseline: do not rely on the native OS palette. */
QWidget
{
    color: #212121;
    background-color: #f5f5f5;
}

/* Anything the person types or picks a value into stays white,
   distinct from the app's gray background - makes editable fields
   immediately obvious at a glance. */
QLineEdit, QPlainTextEdit, QTextEdit,
QSpinBox, QDoubleSpinBox, QComboBox,
QDateEdit, QDateTimeEdit
{
    background-color: #ffffff;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled,
QDateEdit:disabled, QDateTimeEdit:disabled
{
    background-color: #f0f0f0;
    color: #9e9e9e;
}

QToolTip
{
    color: #212121;
    background-color: #ffffff;
    border: 1px solid #bdbdbd;
}

QFrame#SummaryWidget
{
    border: 1px solid #bdbdbd;
    border-radius: 8px;
    background-color: white;
}

QFrame#SummaryWidget:hover
{
    border: 2px solid #1976d2;
}

QFrame#SiteCapacityWidget
{
    border: 1px solid #bdbdbd;
    border-radius: 8px;
    background-color: white;
    padding: 8px;
}
